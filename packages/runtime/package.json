{
    "name": "@sbwp/runtime",
    "version": "0.0.0",
    "description": "Backend runtime for the apps suite: routes manifest, handler wrapper, and handler context.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CelestialDreamEntertainment/platform.git",
        "directory": "packages/runtime"
    },
    "engines": {
