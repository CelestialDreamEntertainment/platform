{
    "name": "@sbwp/build",
    "version": "0.0.0",
    "description": "Build CLI for the apps suite: bundles one Lambda per route, writes the routes JSON, and runs local dev.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CelestialDreamEntertainment/platform.git",
        "directory": "packages/build"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "bin": {
        "sbwp": "./bin/sbwp.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "bin",
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b"
    },
    "dependencies": {
        "commander": "^15.1.0",
        "esbuild": "^0.28.2",
        "yazl": "^3.3.1"
    },
    "peerDependencies": {
        "@sbwp/runtime": "workspace:*"
    },
    "devDependencies": {
        "@sbwp/runtime": "workspace:*",
        "@types/yazl": "^3.3.1",
        "zod": "^4.6.7"
    }
}
