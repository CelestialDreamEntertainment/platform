{
    "name": "@sbwp/web",
    "version": "0.0.0",
    "description": "Frontend package for the apps suite: auth client, typed API client, test helpers, base Mantine theme and Vite preset.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CelestialDreamEntertainment/platform.git",
        "directory": "packages/web"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "default": "./dist/testing/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b"
    },
    "peerDependencies": {
        "@mantine/core": "^9.8.0",
        "@mantine/hooks": "^9.8.0",
        "@vitejs/plugin-react": "^6.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vite": "^8.3.8",
        "zod": "^4.6.7"
    },
    "peerDependenciesMeta": {
        "@vitejs/plugin-react": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "@mantine/core": "^9.8.0",
        "@mantine/hooks": "^9.8.0",
        "@sbwp/runtime": "workspace:*",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.10",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "jsdom": "^31.0.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "vite": "^8.3.8",
        "zod": "^4.6.7"
    }
}
