{
    "name": "platform",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm -r exec tsc -p tsconfig.test.json",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test": "pnpm build && vitest run --coverage",
        "test:watch": "vitest",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,yml,yaml,css}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    }
}
